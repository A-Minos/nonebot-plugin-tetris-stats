{
  "$schema": ".lang.schema.json",
  "interaction": {
    "permission_denied": "你没有执行此命令的权限",
    "wrong": {
      "query_bot": "无法查询机器人信息"
    },
    "warning": {
      "unverified": "* 由于无法验证账号绑定信息，无法保证查询结果属于目标用户。"
    }
  },
  "error": {
    "MessageFormatError": {
      "TETR.IO": "用户名/ID不合法",
      "TOS": "用户名/ID不合法",
      "TOP": "用户名不合法",
      "duration": "时间格式不正确"
    },
    "RequestError": {
      "request": {
        "api": "API 请求失败",
        "cloudflare": "无法绕过 Cloudflare 防护",
        "response": "请求失败，状态码：{status_code} {reason}\n{body}",
        "transport": "请求错误\n{detail}",
        "failover": "所有地址均不可用\n{errors}"
      },
      "TETR.IO": {
        "leaderboard": "排行榜请求错误：\n{detail}",
        "user_info": "用户信息请求错误：\n{detail}",
        "summaries": "用户摘要信息请求错误：\n{detail}",
        "league_history": "段位历史记录请求错误：\n{detail}",
        "records": "用户记录请求错误：\n{detail}"
      },
      "TOS": {
        "user_info": "用户信息请求错误：\n{detail}"
      }
    }
  },
  "template": {
    "template_language": "zh-CN"
  },
  "bind": {
    "not_found": "未找到绑定信息",
    "no_account": "你尚未绑定 {game} 账号",
    "confirm_unbind": "确定要解绑吗？",
    "config_success": "配置成功",
    "verify_already": "你已完成验证。",
    "verify_failed": "验证失败，请确认目标 {game} 账号已绑定到当前 Discord 账号。",
    "only_discord": "目前仅支持 Discord 账号验证",
    "confirm_yes": "是",
    "confirm_no": "否"
  },
  "record": {
    "not_found": "未找到用户 {username} 的“{mode}”记录",
    "blitz": "Blitz",
    "sprint": "40行"
  },
  "list": {
    "no_snapshot": "暂无 TETR.IO 段位排行榜快照，请稍后再试"
  },
  "stats": {
    "user_info": "用户 {name}（{id}）",
    "no_rank": "，暂无段位统计数据",
    "rank_info": "，段位分 {rating}±{rd}（{vol}）",
    "no_game": "，暂无游戏数据",
    "recent_games": "，最近 {count} 局数据",
    "daily_stats": "用户 {name} 的 24 小时统计：",
    "no_daily": "用户 {name} 暂无 24 小时统计数据",
    "history_stats": "\n历史统计：",
    "no_history": "\n暂无历史统计数据",
    "lpm": "\nL'PM：{lpm}（{pps} PPS）",
    "apm": "\nAPM：{apm}（x{apl}）",
    "adpm": "\nADPM：{adpm}（x{adpl}）（{vs} VS）",
    "sprint_pb": "\n40行：{time}s",
    "marathon_pb": "\n马拉松：{score}",
    "challenge_pb": "\n挑战：{score}"
  },
  "template_ui": {
    "invalid_tag": "{revision} 不是模板仓库中的有效标签",
    "update_success": "模板更新成功",
    "update_failed": "模板更新失败"
  },
  "help": {
    "usage": "输入“{command} --help”查看帮助"
  },
  "prompt": {
    "io_check": "io查我",
    "io_bind": "iobind {{gameID}}",
    "top_check": "top查我",
    "top_bind": "topbind {{gameID}}",
    "tos_check": "茶服查我",
    "tos_bind": "tosbind {{gameID}}"
  },
  "retry": {
    "message": "正在重试：{func}（{i}/{max_attempts}）",
    "screenshot": "截图失败，正在重试"
  },
  "mask": {
    "name": "已屏蔽",
    "updated": "{uid} 当前屏蔽字段: {fields}",
    "none": "无",
    "empty": "暂无被屏蔽的玩家",
    "invalid_field": "未知字段: {fields}\n可用字段: {available}",
    "fields": {
      "name": "名字",
      "avatar": "头像",
      "banner": "横幅",
      "bio": "简介",
      "country": "国旗"
    }
  },
  "command": {
    "root": {
      "description": "俄罗斯方块相关游戏数据查询",
      "usage": "先用 io绑定 / top绑定 / 茶服绑定 绑定自己的账号，之后查询时用「我」代替账号即可。查询别人时 @ 对方或直接输入用户名。",
      "examples": "io绑定 Teronya\nio查 我\nio查 我 --compare 7d\nio记录40l 我\niorank x+\n茶服查 我",
      "plugin_description": "用于查询俄罗斯方块相关游戏玩家数据的插件",
      "plugin_usage": "发送 tstats --help 查看用法"
    },
    "tetrio": {
      "description": "TETR.IO 游戏命令",
      "bind": {
        "description": "绑定 TETR.IO 账号",
        "args": {
          "account": {
            "notice": "TETR.IO 用户名 / ID"
          }
        },
        "shortcut": "io绑定"
      },
      "config": {
        "description": "配置 TETR.IO 查询",
        "options": {
          "default_template": {
            "help": "设置默认查询模板",
            "args": {
              "template": {
                "notice": "模板版本"
              }
            }
          },
          "default_compare": {
            "help": "设置默认对比时间间隔",
            "args": {
              "compare": {
                "notice": "对比时间间隔（如 7d, 2w, 24h）"
              }
            }
          }
        },
        "shortcut": "io配置"
      },
      "list": {
        "description": "查询 TETR.IO 段位排行榜",
        "options": {
          "max_tr": {
            "help": "最高 TR"
          },
          "min_tr": {
            "help": "最低 TR"
          },
          "limit": {
            "help": "结果数量"
          },
          "country": {
            "help": "国家代码"
          },
          "sort": {
            "help": "排名指标",
            "args": {
              "sort": {
                "notice": "排名指标（league、pps、apm、adpm、apl 或 adpl）"
              }
            }
          }
        }
      },
      "query": {
        "description": "查询 TETR.IO 游戏信息",
        "args": {
          "who": {
            "notice": "@要查询的用户 / 我 / TETR.IO 用户名 / ID"
          }
        },
        "options": {
          "template": {
            "help": "选择查询模板",
            "args": {
              "template": {
                "notice": "模板版本"
              }
            }
          },
          "compare": {
            "help": "与多久之前的数据对比",
            "args": {
              "compare": {
                "notice": "对比时间间隔（如 7d, 2w, 24h）"
              }
            }
          }
        },
        "shortcut": "io查"
      },
      "rank": {
        "description": "查询 TETR.IO 段位信息",
        "all": {
          "description": "查询所有段位概览",
          "options": {
            "template": {
              "help": "选择查询模板",
              "args": {
                "template": {
                  "notice": "模板版本"
                }
              }
            }
          }
        },
        "detail": {
          "description": "查询指定段位的详细信息",
          "args": {
            "rank": {
              "notice": "段位名称"
            }
          }
        },
        "shortcut": "iorank"
      },
      "record": {
        "args": {
          "who": {
            "notice": "@要查询的用户 / 我 / TETR.IO 用户名 / ID"
          }
        },
        "options": {
          "type": {
            "help": "记录类型",
            "args": {
              "record_type": {
                "notice": "记录类型（top、recent、progression）"
              }
            }
          },
          "index": {
            "help": "记录序号",
            "args": {
              "index": {
                "notice": "记录序号"
              }
            }
          }
        },
        "shortcuts": {
          "blitz": "io记录blitz",
          "sprint": "io记录40l"
        }
      },
      "unbind": {
        "description": "解绑 TETR.IO 账号",
        "shortcut": "io解绑"
      },
      "verify": {
        "description": "验证 TETR.IO 账号",
        "shortcut": "io验证"
      },
      "mask": {
        "description": "管理 TETR.IO 玩家展示信息屏蔽",
        "add": {
          "description": "屏蔽玩家的展示信息",
          "args": {
            "account": {
              "notice": "TETR.IO 用户名 / ID"
            },
            "fields": {
              "notice": "屏蔽字段, 默认全部"
            }
          },
          "shortcut": "io屏蔽"
        },
        "remove": {
          "description": "解除玩家的展示信息屏蔽",
          "args": {
            "account": {
              "notice": "TETR.IO 用户名 / ID"
            },
            "fields": {
              "notice": "解除字段, 默认全部"
            }
          },
          "shortcut": "io解屏蔽"
        },
        "list": {
          "description": "列出被屏蔽的玩家",
          "shortcut": "io屏蔽列表"
        }
      }
    },
    "top": {
      "description": "TOP 游戏命令",
      "bind": {
        "description": "绑定 TOP 账号",
        "args": {
          "account": {
            "notice": "TOP 用户名 / ID"
          }
        },
        "shortcut": "top绑定"
      },
      "unbind": {
        "description": "解绑 TOP 账号",
        "shortcut": "top解绑"
      },
      "config": {
        "description": "配置 TOP 查询",
        "options": {
          "default_compare": {
            "help": "设置默认对比时间间隔",
            "args": {
              "compare": {
                "notice": "对比时间间隔（如 7d, 2w, 24h）"
              }
            }
          }
        },
        "shortcut": "top配置"
      },
      "query": {
        "description": "查询 TOP 游戏信息",
        "args": {
          "who": {
            "notice": "@要查询的用户 / 我 / TOP 用户名"
          }
        },
        "options": {
          "compare": {
            "help": "与多久之前的数据对比",
            "args": {
              "compare": {
                "notice": "对比时间间隔（如 7d, 2w, 24h）"
              }
            }
          }
        },
        "shortcut": "top查"
      }
    },
    "tos": {
      "description": "TOS 游戏命令",
      "bind": {
        "description": "绑定 TOS 账号",
        "args": {
          "account": {
            "notice": "TOS 用户名 / ID"
          }
        },
        "shortcut": "茶服绑定"
      },
      "unbind": {
        "description": "解绑 TOS 账号",
        "shortcut": "茶服解绑"
      },
      "config": {
        "description": "配置 TOS 查询",
        "options": {
          "default_compare": {
            "help": "设置默认对比时间间隔",
            "args": {
              "compare": {
                "notice": "对比时间间隔（如 7d, 2w, 24h）"
              }
            }
          }
        },
        "shortcut": "茶服配置"
      },
      "query": {
        "description": "查询 TOS 游戏信息",
        "args": {
          "who": {
            "notice": "@要查询的用户 / 我 / TOS 用户名 / TeaID"
          }
        },
        "options": {
          "compare": {
            "help": "与多久之前的数据对比",
            "args": {
              "compare": {
                "notice": "对比时间间隔（如 7d, 2w, 24h）"
              }
            }
          }
        },
        "shortcut": "茶服查"
      }
    }
  }
}
